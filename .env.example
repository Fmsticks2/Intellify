# Intellify Wave 2 Environment Variables

# 0G Network Configuration
# Replace with your actual 0G network RPC URL
NEXT_PUBLIC_0G_RPC_URL=https://evmrpc-testnet.0g.ai

# Contract Addresses (update with deployed contract addresses)
NEXT_PUBLIC_INTELLIFY_CONTRACT_ADDRESS=0x37525E8B82C776F608eCA8A49C000b98a456fBdD
NEXT_PUBLIC_INFT_CONTRACT_ADDRESS=0x37525E8B82C776F608eCA8A49C000b98a456fBdD
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ZK_PRIVACY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Project ID (optional, for enhanced wallet connection)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Application Configuration
NEXT_PUBLIC_APP_NAME=Intellify
NEXT_PUBLIC_APP_DESCRIPTION=Decentralized AI Knowledge Companion

# Network Configuration
NEXT_PUBLIC_CHAIN_ID=16600
NEXT_PUBLIC_CHAIN_NAME=0G Newton Testnet
NEXT_PUBLIC_NATIVE_CURRENCY_NAME=A0GI
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=A0GI
NEXT_PUBLIC_NATIVE_CURRENCY_DECIMALS=18

# Block Explorer
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://chainscan-newton.0g.ai

# IPFS/Storage Configuration (if using external IPFS)
# NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# PINATA_API_KEY=your_pinata_api_key
# PINATA_SECRET_API_KEY=your_pinata_secret_key

# Development/Debug
NEXT_PUBLIC_DEBUG=false

# --- Deployment Variables (Hardhat/Foundry) ---
# Private key used for contract deployment (DO NOT commit real keys)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Etherscan-compatible API key (used for verification)
# For 0G explorers, reuse the same key if applicable
ETHERSCAN_API_KEY=your_etherscan_or_chainscan_api_key

# 0G Mainnet and Galileo RPCs (used by Hardhat/Foundry)
OG_MAINNET_RPC_URL=https://evmrpc.0g.ai
OG_GALILEO_RPC_URL=https://evmrpc-testnet.0g.ai

# Optional: 0G explorer overrides (verification)
OG_MAINNET_EXPLORER_URL=https://chainscan.0g.ai
OG_MAINNET_EXPLORER_API_URL=https://chainscan.0g.ai/api
OG_TESTNET_EXPLORER_URL=https://chainscan-testnet.0g.ai
OG_TESTNET_EXPLORER_API_URL=https://chainscan-testnet.0g.ai/api
OG_GALILEO_EXPLORER_URL=https://chainscan-galileo.0g.ai
OG_GALILEO_EXPLORER_API_URL=https://chainscan-galileo.0g.ai/api

# --- Example Mainnet Frontend Values ---
# Use these if deploying frontend against 0G mainnet
# Update addresses after on-chain deployment
NEXT_PUBLIC_CHAIN_ID=16661
NEXT_PUBLIC_CHAIN_NAME=0G Mainnet
NEXT_PUBLIC_NATIVE_CURRENCY_NAME=0G
NEXT_PUBLIC_NATIVE_CURRENCY_SYMBOL=0G
NEXT_PUBLIC_NATIVE_CURRENCY_DECIMALS=18
NEXT_PUBLIC_BLOCK_EXPLORER_URL=https://chainscan.0g.ai
NEXT_PUBLIC_INTELLIFY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_INFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MARKETPLACE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ZK_PRIVACY_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# 0G Storage Indexer (optional)
NEXT_PUBLIC_0G_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai